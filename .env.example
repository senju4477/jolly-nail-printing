# Public website origin. Set before building and use the same value at runtime.
NEXT_PUBLIC_SITE_URL=https://centredbycare.com.au

# Copy these values from your Hostinger MySQL database connection details.
# These variables are server-only. Never prefix them with NEXT_PUBLIC_.
DB_HOST=localhost
DB_PORT=3306
DB_USER=replace-with-hostinger-database-user
DB_PASSWORD=replace-with-hostinger-database-password
DB_NAME=replace-with-hostinger-database-name
DB_CONNECTION_LIMIT=5

# Enable only when your database endpoint supports TLS with a trusted certificate.
DB_SSL=false
